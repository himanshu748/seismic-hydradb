    "stills": "remotion still SeismicLaunch"
  },
  "dependencies": {
    "@remotion/cli": "4.0.512",
    "@remotion/media": "4.0.512",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.512"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.512",
    "@types/react": "19.2.7",
    "eslint": "9.19.0",
    "typescript": "5.9.3"
  }
}
