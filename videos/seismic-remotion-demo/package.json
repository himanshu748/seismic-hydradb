{
  "name": "seismic-remotion-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Caption-free Remotion demo for Seismic and Hack Hydra Track 02B",
  "license": "MIT",
  "scripts": {
    "dev": "remotion studio --no-open",
    "audio:murf": "node scripts/generate-murf.mjs",
